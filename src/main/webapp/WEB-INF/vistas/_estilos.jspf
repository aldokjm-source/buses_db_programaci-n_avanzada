<%@ page pageEncoding="UTF-8" %>
<style>
    body { font-family: Arial, sans-serif; margin: 32px; color: #222; max-width: 980px; }
    h1 { margin-bottom: 4px; }
    nav a { margin-right: 12px; }
    table { border-collapse: collapse; width: 100%; margin-top: 16px; }
    th, td { border: 1px solid #ccc; padding: 8px 10px; text-align: left; }
    th { background: #f2f2f2; }
    .msg { padding: 12px 16px; border: 1px solid #ccc; margin: 16px 0; }
    .msg ul { margin: 0; padding-left: 20px; }
    .ok { color: #0f5132; background: #d1e7dd; border-color: #badbcc; }
    .error { color: #842029; background: #f8d7da; border-color: #f5c2c7; }
    form.bus label { display: block; margin-top: 12px; font-weight: bold; }
    form.bus input[type=text], form.bus select { width: 360px; padding: 6px; }
    .acciones { margin-top: 20px; }
    .btn { display: inline-block; padding: 7px 14px; border: 1px solid #0d6efd; background: #0d6efd;
           color: #fff; text-decoration: none; border-radius: 4px; cursor: pointer; font-size: 14px; }
    .btn.sec { background: #fff; color: #0d6efd; }
    .btn.peligro { background: #dc3545; border-color: #dc3545; }
    dl.detalle dt { font-weight: bold; margin-top: 8px; }
    dl.detalle dd { margin-left: 0; }
</style>
